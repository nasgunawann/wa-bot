# Google Gemini AI Configuration
# Dapatkan API Key gratis Anda di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model utama yang digunakan oleh bot (misal: gemini-2.5-flash)
# Jika tidak ditentukan, bot secara otomatis menggunakan model fallback: gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
